# ─────────────────────────────────────────────
# LangHack Docker 环境变量模板
# 使用方法: cp .env.example .env  然后填入实际值
# 或运行:   ./deploy.sh  由向导自动生成
# ⚠️ 切勿将 .env 提交到 Git 仓库！
# ─────────────────────────────────────────────

# ── 数据库主库 ──
DB_URL=jdbc:mysql://mysql-master:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=<your-mysql-password>

# ── 数据库从库（读写分离） ──
DB_SLAVE_URL=jdbc:mysql://mysql-slave:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_SLAVE_USERNAME=root
DB_SLAVE_PASSWORD=<your-mysql-password>

# ── MySQL 容器 ──
MYSQL_ROOT_PASSWORD=<your-mysql-password>
MYSQL_DATABASE=english_learning
MYSQL_REPLICATION_USER=replicator
MYSQL_REPLICATION_PASSWORD=<your-replication-password>

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<your-redis-password>

# ── JWT（至少 32 字符，建议 openssl rand -base64 48 生成） ──
JWT_SECRET=<your-jwt-secret-at-least-32-chars>

# ── AI 接口（可选，也可部署后在运维面板 → AI服务管理中配置） ──
OPENROUTER_API_KEY=
TUTOR_API_BASE_URL=http://localhost:8000/api/tutor
VITE_TUTOR_API_BASE_URL=/tutor
# HiAgent（AI 改写 + AI 问答需使用两套完全不同的 HiAgent 应用凭证）
# 改写应用（CET-4/6/学术版/中英对照）
HIAGENT_API_KEY=
HIAGENT_APP_ID=
# 问答应用（文章划词 AI 问答，必须独立配置，不 fallback 到改写凭证）
HIAGENT_QA_API_KEY=
HIAGENT_QA_APP_ID=
# HIAGENT_API_URL=https://agent.imau.edu.cn:32300/api/proxy/api/v1

# ── AI 翻译（可选，也可在运维面板配置） ──
AI_TRANSLATE_API_URL=https://api.siliconflow.cn/v1/chat/completions
AI_TRANSLATE_API_KEY=
AI_TRANSLATE_MODEL=Qwen/Qwen2.5-7B-Instruct

# ── CORS（逗号分隔，包含所有允许前端访问后端的来源） ──
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80

# ── Docker 镜像源 fallback ──
# auto: 优先使用国内公网镜像源，失败时降级到本地 registry
# public: 强制使用国内公网镜像源
# local: 强制使用本地 registry
IMAGE_SOURCE_MODE=auto
# 本地 Harbor / registry 地址（示例）
LOCAL_REGISTRY=localhost:5000
# 当前实际生效的 Docker 镜像前缀（通常由 deploy.sh 自动写入）
IMAGE_REGISTRY_PREFIX=
# 国内公网 Docker 镜像前缀（示例使用 1Panel 公网代理）
PUBLIC_REGISTRY_PREFIX=docker.1panel.live/library/
# 用于探测公共镜像源可达性的镜像
PUBLIC_IMAGE_PROBE=node:20-alpine

# ── 构建网络环境（Docker build 阶段依赖下载方式） ──
# public:   npm/Maven/Alpine 包从国内公网镜像源下载（默认）
# intranet: 通过内网 Nexus 代理下载（无公网访问时使用）
BUILD_NETWORK_ENV=public
# npm 公网国内镜像源（默认使用 npmmirror）
NPM_REGISTRY=https://registry.npmmirror.com
# Maven 公网国内镜像源（默认使用阿里云 Maven）
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
# Alpine apk 公网国内镜像源（默认使用阿里云 Alpine）
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
# 以下为内网 Nexus 示例：
# NPM_REGISTRY=http://172.20.14.249:8081/repository/npm-proxy/
# MAVEN_MIRROR_URL=http://172.20.14.249:8081/repository/maven-public/
# ALPINE_MIRROR=http://172.20.14.249:8081/repository/alpine-mirror/

# ── 端口映射 ──
PORT_FRONTEND=80
PORT_BACKEND=8080
PORT_MYSQL=3306
PORT_MYSQL_SLAVE=3307
PORT_REDIS=6379

# ── HTTPS/SSL（可选，deploy.sh 向导自动生成） ──
HTTPS_ENABLED=false
# PORT_HTTPS=443
# SSL_CERT_PATH=./ssl/fullchain.pem
# SSL_KEY_PATH=./ssl/privkey.pem
# SSL_DOMAIN=your-domain.com

# ── 数据库备份 ──
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ── 自动更新（定期从 GitHub 拉取并重部署） ──
AUTO_UPDATE_ENABLED=false
AUTO_UPDATE_CRON=0 * * * *
AUTO_UPDATE_BRANCH=master
AUTO_UPDATE_MAINTENANCE=true
AUTO_UPDATE_PRE_BACKUP=true

# ── 热部署 (Deployer Sidecar) ──
# 项目在宿主机上的绝对路径 (deployer 容器挂载时使用)
# 示例: /home/ubuntu/LangHack
PROJECT_HOST_PATH=
# ── git 认证（二选一）──────────────────────────────────────────────────
# 方式 A: HTTPS + Personal Access Token（需 Contents Read 权限）
# 在 GitHub → Settings → Developer Settings → Personal access tokens (fine-grained) 创建
GIT_TOKEN=
# 方式 B: SSH Key 目录（宿主机 ~/.ssh 目录绝对路径，需包含 id_ed25519/id_rsa + known_hosts）
# 示例: /root/.ssh 或 /home/ubuntu/.ssh
GIT_SSH_KEY_DIR=
# 部署器镜像名 (docker compose --profile deploy build deployer 构建)
# APP_UPDATE_DEPLOYER_IMAGE=langhack-deployer:latest
# APP_UPDATE_SUPPORTED=true

# ── SSO Configuration / SSO 配置 ──────────────────────────────────────
SSO_ENABLED=true
SSO_PROTOCOL=CAS
SSO_CAS_ENABLED=true
SSO_CAS_SERVER_URL=https://ids.imau.edu.cn/authserver
# ⚠️ 应用服务器地址（对应官方 web.xml 的 serverName）
# 格式: 协议://域名[:端口]  示例: https://langhack.imau.edu.cn
# service URL 由此值 + /api/auth/sso/callback 自动拼接，必须与 CAS 注册的域名一致
SSO_CAS_SERVER_NAME=https://langhack.imau.edu.cn
# ⚠️ 前端 URL（后端 302 重定向时使用，默认同 APP_BASE_URL）
APP_BASE_URL=https://langhack.imau.edu.cn

# ── 学校数据集成（可选，也可部署后在运维面板管理） ──────────────────────
# 数据源类型: api (REST API 签名认证) 或 etl (JDBC 直连)
SCHOOL_DATA_SOURCE=api
# API 模式 — 9 个 endpoint URL 已在代码中内置（cdsp.imau.edu.cn）
# 官方认证方式: sign = Base64(MD5(appId + appSecret + timestamp))
SCHOOL_API_APP_ID=
SCHOOL_API_APP_SECRET=
# ETL 模式 — 7 个查询 SQL 已在代码中内置，只需配置数据库连接
# SCHOOL_ETL_JDBC_URL=jdbc:mysql://school-db.imau.edu.cn:3306/school_db
# SCHOOL_ETL_USERNAME=
# SCHOOL_ETL_PASSWORD=
# 启用定时同步（全量 02:00 / 增量每小时 / 校验 04:00）
SCHOOL_SYNC_ENABLED=false

# ── 零停机热更新（运维面板 → 热更新） ────────────────────────────────
# 后端容器内的 HotDeployController 通过挂载的 docker.sock 启动一个临时
# deployer 容器执行 scripts/hot-deploy.sh。deployer 容器需要把宿主机
# 项目根路径挂到 /workspace，因此必须告诉后端「宿主机上的项目根目录」。
# deploy.sh 会自动把当前 PROJECT_ROOT 写进来；如果手工部署请填实际路径。
HOT_DEPLOY_HOST_PROJECT=/data/langhack
