# LangHack 生产环境变量配置
# 复制此文件为 .env 并填写实际值：cp .env.example .env
# 警告：.env 文件包含敏感信息，切勿提交到版本控制！

# ─────────────────────────────────────────────
# 数据库配置（主库）
# ─────────────────────────────────────────────
DB_URL=jdbc:mysql://mysql-master:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# ─────────────────────────────────────────────
# 数据库配置（从库，读写分离）
# 如不使用从库，填与主库相同的值即可
# ─────────────────────────────────────────────
DB_SLAVE_URL=jdbc:mysql://mysql-slave:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_SLAVE_USERNAME=root
DB_SLAVE_PASSWORD=your_strong_password_here

# ─────────────────────────────────────────────
# MySQL 容器内部配置
# MYSQL_ROOT_PASSWORD 应与 DB_PASSWORD 保持一致
# ─────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_password_here
MYSQL_DATABASE=english_learning
MYSQL_REPLICATION_USER=replicator
MYSQL_REPLICATION_PASSWORD=repl_password_here

# ─────────────────────────────────────────────
# Redis 配置
# REDIS_HOST 在 docker-compose 中固定为服务名 redis，不需修改
# ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ─────────────────────────────────────────────
# JWT 密钥（生产环境请使用至少 32 位随机字符串）
# 生成命令：openssl rand -base64 48
# ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_at_least_32_chars_here

# ─────────────────────────────────────────────
# AI 接口配置
# ─────────────────────────────────────────────
# OpenRouter API Key（用于 AI 问答功能）
# 申请地址：https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-xxx

# AI Tutor 服务地址（内部 Python 服务，填实际 IP）
TUTOR_API_BASE_URL=http://TUTOR_SERVER_IP:8000/api/tutor

# ─────────────────────────────────────────────
# 腾讯翻译云配置（可选）
# 不填则翻译功能不可用，留空即可
# 申请地址：https://console.cloud.tencent.com/cam/capi
# ─────────────────────────────────────────────
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
