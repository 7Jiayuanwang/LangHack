[mysqld]
# ─────────────────────────────────────────────
# 主库身份标识
# ─────────────────────────────────────────────
server-id = 1

# ─────────────────────────────────────────────
# Binary Log（主从复制核心）
# ─────────────────────────────────────────────
log-bin = mysql-bin
binlog-format = ROW
# binlog 保留 7 天（单位：秒）
binlog-expire-logs-seconds = 604800
max-binlog-size = 100M

# ─────────────────────────────────────────────
# GTID 模式（保证主从一致性，便于故障切换）
# ─────────────────────────────────────────────
gtid-mode = ON
enforce-gtid-consistency = ON

# ─────────────────────────────────────────────
# InnoDB 性能调优
# innodb-buffer-pool-size 建议设为可用内存的 50-70%
# Docker 容器限制 2G，扣除 OS + MySQL 开销约 1G 可用
# ─────────────────────────────────────────────
innodb-buffer-pool-size = 1G
innodb-buffer-pool-instances = 2
innodb-log-file-size = 256M
innodb-flush-log-at-trx-commit = 1
innodb-flush-method = O_DIRECT

# ─────────────────────────────────────────────
# 字符集与排序规则
# ─────────────────────────────────────────────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# ─────────────────────────────────────────────
# 连接与查询优化
# ─────────────────────────────────────────────
max-connections = 500
max-allowed-packet = 64M
wait-timeout = 28800
interactive-timeout = 28800

# ─────────────────────────────────────────────
# 慢查询日志（生产环境建议开启，便于性能分析）
# ─────────────────────────────────────────────
slow-query-log = ON
slow-query-log-file = /var/lib/mysql/slow.log
long-query-time = 2
log-queries-not-using-indexes = OFF

# ─────────────────────────────────────────────
# 半同步复制（降低主从数据丢失风险）
# 插件在 init 脚本中安装，这里预设参数
# ─────────────────────────────────────────────
# rpl_semi_sync_master_enabled = ON  -- 需要插件先安装
# rpl_semi_sync_master_timeout = 3000  -- 3秒超时降级为异步

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
