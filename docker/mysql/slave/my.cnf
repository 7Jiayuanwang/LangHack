[mysqld]
# ─────────────────────────────────────────────
# 从库身份标识（必须与主库不同）
# ─────────────────────────────────────────────
server-id = 2

# ─────────────────────────────────────────────
# 中继日志（从库接收主库 binlog 的载体）
# ─────────────────────────────────────────────
relay-log = relay-bin
relay-log-purge = ON

# ─────────────────────────────────────────────
# 只读保护（防止误写从库）
# 注意: read-only / super-read-only 不能在 .cnf 中静态设置，
# 否则会阻塞 docker-entrypoint-initdb.d 中的 DDL init 脚本执行
# （ALTER TABLE ... ADD COLUMN IF NOT EXISTS 在 read_only=ON 时报 ERROR 1290）
# 两者均在 init-replication.sh 末尾通过 SET GLOBAL 动态启用
# ─────────────────────────────────────────────
# read-only = ON        -- 由 init-replication.sh 动态设置
# super-read-only = ON  -- 由 init-replication.sh 动态设置

# ─────────────────────────────────────────────
# GTID 模式（需与主库一致）
# ─────────────────────────────────────────────
gtid-mode = ON
enforce-gtid-consistency = ON

# ─────────────────────────────────────────────
# 从库 binlog（若需要链式复制或备份则开启）
# ─────────────────────────────────────────────
log-bin = mysql-slave-bin
log-slave-updates = ON

# ─────────────────────────────────────────────
# InnoDB 性能调优（从库读为主，同等缓冲区提升查询性能）
# Docker 容器限制 2G，扣除 OS + MySQL 开销约 1G 可用
# ─────────────────────────────────────────────
innodb-buffer-pool-size = 1G
innodb-buffer-pool-instances = 2
innodb-flush-log-at-trx-commit = 2
innodb-flush-method = O_DIRECT

# ─────────────────────────────────────────────
# 字符集与排序规则（必须与主库一致）
# ─────────────────────────────────────────────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# ─────────────────────────────────────────────
# 连接限制（从库主要承担读请求）
# ─────────────────────────────────────────────
max-connections = 300
max-allowed-packet = 64M
wait-timeout = 28800
interactive-timeout = 28800

# ─────────────────────────────────────────────
# 半同步复制（从库端）
# 插件在 init 脚本中安装，这里预设参数
# ─────────────────────────────────────────────
# rpl_semi_sync_slave_enabled = ON  -- 需要插件先安装

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
