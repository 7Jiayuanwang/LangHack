[mysqld]
# ─────────────────────────────────────────────
# 从库身份标识（必须与主库不同）
# ─────────────────────────────────────────────
server-id = 2

# ─────────────────────────────────────────────
# 中继日志（从库接收主库 binlog 的载体）
# ─────────────────────────────────────────────
relay-log = relay-bin
relay-log-purge = ON

# ─────────────────────────────────────────────
# 只读保护（防止误写从库）
# super-read-only 同时拦截 SUPER 权限账号的写操作
# ─────────────────────────────────────────────
read-only = ON
super-read-only = ON

# ─────────────────────────────────────────────
# GTID 模式（需与主库一致）
# ─────────────────────────────────────────────
gtid-mode = ON
enforce-gtid-consistency = ON

# ─────────────────────────────────────────────
# 复制容错配置
# 跳过重复键错误（初始全量同步时常见，1062=Duplicate entry）
# ─────────────────────────────────────────────
slave-skip-errors = 1062

# ─────────────────────────────────────────────
# 从库 binlog（若需要链式复制或备份则开启）
# ─────────────────────────────────────────────
log-bin = mysql-slave-bin
log-slave-updates = ON

# ─────────────────────────────────────────────
# InnoDB 性能调优（从库可适当调低缓冲区）
# ─────────────────────────────────────────────
innodb-buffer-pool-size = 512M
innodb-flush-log-at-trx-commit = 2
innodb-flush-method = O_DIRECT

# ─────────────────────────────────────────────
# 字符集与排序规则（必须与主库一致）
# ─────────────────────────────────────────────
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci
init-connect = 'SET NAMES utf8mb4'

# ─────────────────────────────────────────────
# 连接限制（从库主要承担读请求）
# ─────────────────────────────────────────────
max-connections = 300
max-allowed-packet = 64M
wait-timeout = 28800
interactive-timeout = 28800

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
