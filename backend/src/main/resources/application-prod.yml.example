# =====================================================================
# LangHack 生产环境配置模板 / Production Configuration Template
# =====================================================================
# 使用方法 / Usage:
#   方式一 (推荐): 复制此文件为 application-prod.yml，填写实际值，启动时指定 profile
#     cp application-prod.yml.example application-prod.yml
#     java -jar app.jar --spring.profiles.active=prod
#
#   方式二: Docker Compose 环境变量（见 docker/.env.example）
#
#   方式三: 命令行参数
#     java -jar app.jar --app.cors.allowed-origins=https://your-domain.com
#
# 优先级: 命令行参数 > application-prod.yml > 环境变量 > application.yml 默认值
# =====================================================================


# ─── CORS 跨域配置（部署后首要配置项！）───────────────────────────────
# 不配置此项，前端将无法访问后端 API，浏览器会报"拒绝访问"
app:
  cors:
    # 填写前端实际访问地址，多个用逗号分隔
    # 示例: https://langhack.example.com
    # 示例: https://www.example.com,https://admin.example.com
    # 示例: http://192.168.1.100:3000 (内网 IP + 端口)
    allowed-origins: https://your-frontend-domain.com

    # 可选：通配符子域名匹配
    # 示例: https://*.example.com
    # allowed-origin-patterns:


# ─── 数据库配置 ──────────────────────────────────────────────────────
spring:
  datasource:
    master:
      jdbc-url: jdbc:mysql://your-db-host:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=GMT%2B8
      username: your_db_user
      password: your_strong_db_password
    slave:
      jdbc-url: jdbc:mysql://your-db-slave-host:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=true&serverTimezone=GMT%2B8
      username: your_db_user
      password: your_strong_db_password

  # ─── Redis 配置 ──────────────────────────────────────────────────
  redis:
    host: your-redis-host
    port: 6379
    password: your_redis_password

  # ─── JWT 配置 ───────────────────────────────────────────────────
  # 生成命令: openssl rand -base64 48
  security:
    jwt:
      secret: your_jwt_secret_at_least_32_chars_long
      # expiration: 2592000000  # 默认30天，如需修改取消注释


# ─── AI 服务配置（至少配置一个）────────────────────────────────────
# HiAgent（主要 AI 提供商）
hiagent:
  api-key: your_hiagent_api_key
  # api-url: https://agent.imau.edu.cn:32300/api/proxy/api/v1  # 默认值，通常无需修改
  app-id: your_hiagent_app_id
  # user-id: LangHack_System  # 默认值

# OpenRouter（备用 AI 提供商）
openrouter:
  api-key: your_openrouter_api_key
  # model: tngtech/deepseek-r1t2-chimera:free  # 默认免费模型


# ─── 腾讯云服务（可选）───────────────────────────────────────────
# 翻译
# tencent:
#   translate:
#     secret-id: your_tencent_secret_id
#     secret-key: your_tencent_secret_key
#   asr:
#     secret-id: your_tencent_asr_secret_id
#     secret-key: your_tencent_asr_secret_key


# ─── 备份配置 ────────────────────────────────────────────────────
# backup:
#   enabled: true
#   dir: /data/backups
#   cron: "0 0 2 * * ?"
#   retention-days: 30
