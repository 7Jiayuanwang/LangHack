<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.english.mapper.ExerciseOptionMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.english.entity.ExerciseOption">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="exercise_id" property="exerciseId" jdbcType="BIGINT"/>
        <result column="option_content" property="optionContent" jdbcType="VARCHAR"/>
        <result column="option_key" property="optionKey" jdbcType="VARCHAR"/>
        <result column="is_correct" property="isCorrect" jdbcType="BOOLEAN"/>
        <result column="order_num" property="orderNum" jdbcType="INTEGER"/>
        <result column="created_time" property="createdTime" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 基础字段 -->
    <sql id="Base_Column_List">
        id, exercise_id, option_content, option_key, is_correct, order_num, created_time
    </sql>

    <!-- 根据习题ID获取选项列表 -->
    <select id="getOptionsByExerciseId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM exercise_options
        WHERE exercise_id = #{exerciseId}
        ORDER BY order_num ASC, option_key ASC
    </select>

    <!-- 获取习题的正确答案 -->
    <select id="getCorrectOption" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM exercise_options
        WHERE exercise_id = #{exerciseId} AND is_correct = TRUE
        LIMIT 1
    </select>

    <!-- 删除习题的所有选项 -->
    <delete id="deleteOptionsByExerciseId">
        DELETE FROM exercise_options
        WHERE exercise_id = #{exerciseId}
    </delete>

</mapper>