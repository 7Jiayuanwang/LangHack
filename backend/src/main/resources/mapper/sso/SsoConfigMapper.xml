<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.english.sso.mapper.SsoConfigMapper">

    <resultMap id="BaseResultMap" type="com.english.sso.entity.SsoConfig">
        <id column="id" property="id"/>
        <result column="config_key" property="configKey"/>
        <result column="config_value" property="configValue"/>
        <result column="config_type" property="configType"/>
        <result column="description" property="description"/>
        <result column="is_encrypted" property="isEncrypted"/>
        <result column="created_time" property="createdTime"/>
        <result column="updated_time" property="updatedTime"/>
    </resultMap>

    <select id="findByConfigKey" resultMap="BaseResultMap">
        SELECT * FROM sso_config
        WHERE config_key = #{configKey}
        LIMIT 1
    </select>

    <select id="findByConfigType" resultMap="BaseResultMap">
        SELECT * FROM sso_config
        WHERE config_type = #{configType}
        ORDER BY config_key
    </select>

</mapper>
