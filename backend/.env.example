# =====================================================================
# LangHack Backend Environment Variables / 后端环境变量配置模板
# =====================================================================
# Usage / 使用方法:
#   cp .env.example .env && vim .env
#
# WARNING: .env contains secrets. NEVER commit it to version control!
# 警告：.env 包含敏感信息，切勿提交到版本控制！
#
# All variables below use the format:
#   VARIABLE=value        # Required / 必填
#   # VARIABLE=value      # Optional (commented out) / 可选（已注释）
# =====================================================================


# ─────────────────────────────────────────────────────────────────────
# CORS Configuration / 跨域配置
# ─────────────────────────────────────────────────────────────────────
# CRITICAL: This is the #1 cause of "Access Denied" errors in production!
# 关键：这是生产环境 "拒绝访问" 错误的首要原因！
#
# Set to your actual frontend URL(s). Multiple origins separated by comma.
# 设置为实际的前端地址。多个域名用逗号分隔。
#
# Examples / 示例:
#   APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
#   APP_CORS_ALLOWED_ORIGINS=https://www.example.com,https://admin.example.com
#   APP_CORS_ALLOWED_ORIGINS=http://192.168.1.100:3000
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Wildcard patterns for subdomain matching / 可选：通配符子域名匹配
# Example / 示例: https://*.example.com
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=


# ─────────────────────────────────────────────────────────────────────
# Database Configuration (Master) / 数据库配置（主库）
# ─────────────────────────────────────────────────────────────────────
# CRITICAL: Change default password in production!
# 关键：生产环境必须修改默认密码！
DB_URL=jdbc:mysql://localhost:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_strong_password_here

# Database SSL mode (optional, recommended for production)
# 数据库 SSL 模式（可选，生产环境建议开启）
# DB_SSL_MODE=REQUIRED

# ─────────────────────────────────────────────────────────────────────
# Database Configuration (Slave / Read Replica) / 数据库配置（从库/读副本）
# ─────────────────────────────────────────────────────────────────────
# Optional: If not using read replicas, these default to master values.
# 可选：不使用读写分离时，默认使用主库配置。
# DB_SLAVE_URL=jdbc:mysql://localhost:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
# DB_SLAVE_USERNAME=root
# DB_SLAVE_PASSWORD=your_strong_password_here


# ─────────────────────────────────────────────────────────────────────
# JWT Configuration / JWT 配置
# ─────────────────────────────────────────────────────────────────────
# CRITICAL: Must be at least 32 characters (256-bit for HS256).
# 关键：至少 32 个字符（HS256 需要 256 位密钥）。
#
# Generate with / 生成命令: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_at_least_32_chars_long_change_this_in_production


# ─────────────────────────────────────────────────────────────────────
# Redis Configuration / Redis 配置
# ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# Set Redis password for production / 生产环境设置 Redis 密码
# REDIS_PASSWORD=your_redis_password_here


# ─────────────────────────────────────────────────────────────────────
# HiAgent AI Service / HiAgent AI 服务
# ─────────────────────────────────────────────────────────────────────
# Primary AI provider for Q&A features / AI 问答功能主要提供商
# Contact your HiAgent administrator for credentials / 联系 HiAgent 管理员获取凭据
# HIAGENT_API_KEY=your_hiagent_api_key
# HIAGENT_API_URL=https://agent.imau.edu.cn:32300/api/proxy/api/v1
# HIAGENT_APP_ID=your_app_id
# HIAGENT_USER_ID=LangHack_System


# ─────────────────────────────────────────────────────────────────────
# OpenRouter AI Service / OpenRouter AI 服务
# ─────────────────────────────────────────────────────────────────────
# Fallback AI provider / 备用 AI 提供商
# Get your key at / 申请地址: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=tngtech/deepseek-r1t2-chimera:free


# ─────────────────────────────────────────────────────────────────────
# Tencent Cloud - Translation Service / 腾讯云 - 翻译服务
# ─────────────────────────────────────────────────────────────────────
# Optional: Leave empty if translation feature is not used.
# 可选：不使用翻译功能时留空。
# Get credentials at / 申请地址: https://console.cloud.tencent.com/cam/capi
# TENCENT_SECRET_ID=your_secret_id
# TENCENT_SECRET_KEY=your_secret_key


# ─────────────────────────────────────────────────────────────────────
# Tencent Cloud - ASR (Speech Recognition) / 腾讯云 - 语音识别
# ─────────────────────────────────────────────────────────────────────
# Optional: Leave empty if ASR feature is not used.
# 可选：不使用语音识别功能时留空。
# Can share credentials with translation or use separate ones.
# 可与翻译服务共用凭据，也可使用独立凭据。
# TENCENT_ASR_SECRET_ID=your_asr_secret_id
# TENCENT_ASR_SECRET_KEY=your_asr_secret_key
# TENCENT_ASR_REGION=ap-guangzhou


# ─────────────────────────────────────────────────────────────────────
# Backup Configuration / 备份配置
# ─────────────────────────────────────────────────────────────────────
# BACKUP_ENABLED=true
# BACKUP_DIR=./backups
# BACKUP_CRON=0 0 2 * * ?
# BACKUP_RETENTION_DAYS=30
# BACKUP_MAX_COUNT=50
# MYSQLDUMP_PATH=mysqldump
# BACKUP_INCREMENTAL_ENABLED=false
# BACKUP_FULL_INTERVAL_DAYS=7


# ─────────────────────────────────────────────────────────────────────
# Audio Resources / 音频资源
# ─────────────────────────────────────────────────────────────────────
# Absolute path to the directory containing audio files.
# 音频文件所在目录的绝对路径。
# AUDIO_RESOURCE_PATH=/path/to/audio/resources


# ─────────────────────────────────────────────────────────────────────
# TTS 语音合成 (SiliconFlow CosyVoice2)
# ─────────────────────────────────────────────────────────────────────
# SiliconFlow API Key (defaults to AI_TRANSLATE_API_KEY if not set)
# 硅基流动 API 密钥（未设置时回退到翻译用的 Key）
# TTS_API_KEY=sk-your-key-here
# TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
# TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
# 可选发音人: alex(沉稳男), benjamin(低沉男), charles(磁性男), david(开朗男)
#              anna(沉稳女), bella(热情女), claire(温柔女), diana(开朗女)


# ─────────────────────────────────────────────────────────────────────
# Spring Profile / Spring 运行环境
# ─────────────────────────────────────────────────────────────────────
# Set to "prod" for production (enables HTTPS requirement).
# 设置为 "prod" 启用生产模式（强制 HTTPS）。
# SPRING_PROFILES_ACTIVE=dev
