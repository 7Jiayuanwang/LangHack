# =====================================================================
# LangHack Environment Variables / 环境变量配置模板
# =====================================================================
# Usage / 使用方法: cp .env.example .env && vim .env
# WARNING: .env contains secrets — NEVER commit to git!
# 警告：.env 包含敏感信息，切勿提交到版本控制！
#
# For detailed descriptions, see: backend/.env.example
# 详细说明请见: backend/.env.example
# =====================================================================


# ── CORS (Cross-Origin) / 跨域配置 ──────────────────────────────────
# CRITICAL: #1 cause of "Access Denied" in production!
# 关键：生产环境 "拒绝访问" 的首要原因！
# Set to your actual frontend URL(s), comma-separated.
# 设置为实际前端地址，多个用逗号分隔。
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database / 数据库 ────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/english_learning?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=GMT%2B8&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-password-here

# ── JWT ──────────────────────────────────────────────────────────────
# Min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-key-here-at-least-32-chars

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── AI Services / AI 服务 ────────────────────────────────────────────
# HIAGENT_API_KEY=
# HIAGENT_API_URL=https://agent.imau.edu.cn:32300/api/proxy/api/v1
# HIAGENT_APP_ID=
OPENROUTER_API_KEY=your-api-key-here

# ── Tencent Cloud / 腾讯云 (optional) ───────────────────────────────
TENCENT_SECRET_ID=your-secret-id-here
TENCENT_SECRET_KEY=your-secret-key-here

# ── Backup / 备份 (optional) ─────────────────────────────────────────
# BACKUP_ENABLED=true
# BACKUP_DIR=./backups
# BACKUP_CRON=0 0 2 * * ?
# BACKUP_RETENTION_DAYS=30

# ── SSO Configuration / SSO 配置 ──────────────────────────────────────
SSO_ENABLED=true
SSO_PROTOCOL=CAS
SSO_CAS_ENABLED=true
SSO_CAS_SERVER_URL=https://ids.imau.edu.cn/authserver
APP_BASE_URL=http://localhost:8088
