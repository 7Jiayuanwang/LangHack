{
  "name": "english-learning-platform-frontend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build:mobile:vite": "vite build --config vite.config.mobile.js",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --ignore-path ../.gitignore",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path ../.gitignore",
    "format": "prettier --write src/",
    "cap:init": "cap init langhack com.yourcompany.englishlearning",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:run:android": "cap run android",
    "cap:build": "npm run build:mobile:vite && cap sync",
    "mobile:android": "npm run build:mobile:vite && cap sync && cap open android",
    "mobile:build": "npm run build:mobile:vite && cap sync",
    "build:mobile": "npm run build:mobile:vite",
    "deploy:mobile": "npm run build:mobile:vite && npx cap sync && npx cap open android",
    "test": "vitest run"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "axios": "^1.4.0",
    "dompurify": "^3.3.3",
    "echarts": "^6.0.0",
    "element-plus": "^2.3.9",
    "marked": "^17.0.1",
    "pinia": "^2.1.6",
    "rangy": "^1.3.2",
    "vue": "^3.3.4",
    "vue-echarts": "^8.0.1",
    "vue-router": "^4.2.4"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.46.0",
    "eslint-plugin-vue": "^9.16.1",
    "fast-check": "^4.6.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.0.1",
    "sass": "^1.98.0",
    "terser": "^5.44.1",
    "vite": "^5.4.21",
    "vitest": "^4.0.18"
  }
}
