# LangHack Webhook Listener 环境变量
# 复制此文件为 webhook.env 并填入实际值:
#   cp webhook.env.example webhook.env

# GitHub Webhook Secret（必填）
# 在 GitHub 仓库 Settings → Webhooks → Add webhook 时设置的 Secret
# 生成方式: python3 -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=your_webhook_secret_here

# 要监听的部署分支（默认 main）
DEPLOY_BRANCH=master

# 项目根目录的绝对路径
PROJECT_ROOT=/home/deploy/LangHack

# Webhook listener 监听端口（默认 9000，仅 localhost）
WEBHOOK_PORT=9000
