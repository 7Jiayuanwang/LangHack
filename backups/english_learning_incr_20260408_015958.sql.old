(696,'where','hwєә','adv；在哪里 pron；哪里 n；地点','','','unknown','HARD','[]','[]','ecdict_113097959','[{\"examples\":[],\"pos\":\"\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"pro\"},{\"examples\":[],\"pos\":\"r\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"ad\"},{\"examples\":[],\"pos\":\"v\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"At or in what place; hence, in what situation, position, or circumstances; -- used interrogatively. ad\"},{\"examples\":[],\"pos\":\"v\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"At or in which place; at the place in which; hence, in the case or instance in which; -- used relatively. ad\"},{\"examples\":[],\"pos\":\"v\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"To what or which place; hence, to what goal, result, or issue; whither; -- used interrogatively and relatively; as, where are you going? conj. Whereas.\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"& conj. Whethe\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"adv. 在哪里 pron. 哪里 n. 地点\",\"definition\":\"Place; situation.\"}]','ecdict_auto',0,'2026-04-06 18:42:26','2026-04-06 18:42:26'),
