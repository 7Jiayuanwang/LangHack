(1,3,517,'Most functions you use to model the world involve mixing, combining and tweaking these simple functions in some way; so our goal now is to understand how to take derivatives of more complicated combinations; where again, I want you to have a clear picture in mind for each rule.',258,536,'0/2/2/1/0:0,394/2/1/0:1','2026-04-06 10:41:22'),
(2,3,517,'complicated',440,451,'0/130/2/1/0:0,0/130/2/1/0:11','2026-04-06 10:41:38'),
(3,3,517,'Adding them, multiplying them,',612,642,'0/98/3/1/0:0,126/3/1/0:1','2026-04-06 10:41:46'),
(4,3,517,'Adding them',612,623,'0/98/3/1/0:0,0/102/3/1/0:4','2026-04-06 10:41:50'),
(5,3,519,'First of all, to get an intuition, let’s focus on the exponential function 2x2^x2x.',285,368,'0/2/3/1/0:0,112/3/1/0:9','2026-04-07 12:01:55');
/*!40000 ALTER TABLE `underlines` ENABLE KEYS */;
