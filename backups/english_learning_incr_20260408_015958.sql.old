(687,'exponential','.ekspәu\'nenʃәl','a；指数的 n；指数 指数','','','unknown','HARD','[\"s:exponentials\"]','[]','ecdict_-1765414587','[{\"examples\":[],\"pos\":\"a\",\"translation\":\"a. 指数的 n. 指数 指数\",\"definition\":\"of or involving exponents\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"a. 指数的 n. 指数 指数\",\"definition\":\"a function in which an independent variable appears as an exponent\"}]','ecdict_auto',0,'2026-04-06 10:46:43','2026-04-06 10:46:43'),
(688,'function','\'fʌŋkʃәn','n；官能；职务；功能；函数 vi；活动；运行；行使职责 功能；函数','','','unknown','MEDIUM','[\"s:functions\",\"i:functioning\",\"p:functioned\",\"3:functions\",\"d:functioned\"]','[]','ecdict_1380938712','[{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 官能\",\"definition\":\"(mathematics) a mathematical relation such that each element of a given set (the domain of the function) is associated with an element of another set (the range of the function)\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 官能\",\"definition\":\"what something is used for\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 官能\",\"definition\":\"the actions and activities assigned to or required or expected of a person or group\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 官能\",\"definition\":\"a relation such that one thing is dependent on another\"}]','ecdict_auto',0,'2026-04-06 10:46:50','2026-04-06 10:46:50'),
(689,'introduction','.intrә\'dʌkʃәn','n；介绍；传入；采用；初步','','','unknown','EASY','[\"s:introductions\"]','[]','ecdict_1539594266','[{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 介绍\",\"definition\":\"the act of beginning something new\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 介绍\",\"definition\":\"the first section of a communication\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 介绍\",\"definition\":\"a basic or elementary instructional text\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 介绍\",\"definition\":\"a new proposal\"}]','ecdict_auto',0,'2026-04-06 10:46:58','2026-04-06 10:46:58'),
(690,'courses','','月经','','','unknown','MEDIUM','[\"1:s3\",\"0:course\"]','[]','ecdict_957948856','[{\"examples\":[],\"pos\":\"\",\"translation\":\"月经\",\"definition\":\"n education imparted in a series of lessons or meetings n a connected series of events or actions or developments n general line of orientation n a mode of action n a line or route along which something travels or moves n a body of students who are taught together n part of a meal served at one time n (construction) a layer of masonry n facility consisting of a circumscribed area of land or water laid out for a sport v move swiftly through or over v move along, of liquids v hunt with hounds\"}]','ecdict_auto',0,'2026-04-06 10:47:02','2026-04-06 10:47:02'),
(691,'that','ðæt','a；那；那个 conj；以致；因为 pron；那 adv；那么；那样','','','unknown','HARD','[]','[]','ecdict_3558823','[{\"examples\":[],\"pos\":\"\",\"translation\":\"a. 那\",\"definition\":\"pron., a., conj., & As a demonstrative pronoun (pl. Those), that usually points out, or refers to, a person or thing previously mentioned, or supposed to be understood. That, as a demonstrative, may precede the noun to which it refers; as, that which he has said is true; those in the basket are good apples. pron., a., conj., & As an adjective, that has the same demonstrative force as the pronoun, but is followed by a nou\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"a. 那\",\"definition\":\"pron., a., conj., & As a relative pronoun, that is equivalent to who or which, serving to point out, and make definite, a person or thing spoken of, or alluded to, before, and may be either singular or plural. pron., a., conj., & As a conjunction, that retains much of its force as a demonstrative pronou\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"a. 那\",\"definition\":\"pron., a., conj., & To introduce a clause employed as the object of the preceding verb, or as the subject or predicate nominative of a verb. pron., a., conj., & To introduce, a reason or cause; -- equivalent to for that, in that, for the reason that, because. pron., a., conj., & To introduce a purpose; -- usually followed by may, or might, and frequently preceded by so, in order, to the end, etc. pron., a., conj., & To introduce a consequence, result, or effect; -- usually preceded by so or such, sometimes by that. pron., a., conj., & In an elliptical sentence to introduce a dependent sentence expressing a wish, or a cause of surprise, indignation, or the like. pron., a., conj., & As adverb: To such a degree; so; as, he was that frightened he could say nothing.\"}]','ecdict_auto',0,'2026-04-06 11:40:02','2026-04-06 11:40:02'),
(692,'definition','.defi\'niʃәn','n；定义；精确度；清晰度 清晰度；清晰度','','','unknown','MEDIUM','[\"s:definitions\"]','[]','ecdict_-1014418093','[{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 定义\",\"definition\":\"a concise explanation of the meaning of a word or phrase or symbol\"},{\"examples\":[],\"pos\":\"n\",\"translation\":\"n. 定义\",\"definition\":\"clarity of outline\"}]','ecdict_auto',0,'2026-04-06 11:40:05','2026-04-06 11:40:05'),
(693,'explains','','v；解释；说明（explain的三单形式）','','','unknown','MEDIUM','[\"0:explain\",\"1:3\"]','[]','ecdict_-1929323940','[{\"examples\":[],\"pos\":\"\",\"translation\":\"v. 解释\",\"definition\":\"v make plain and comprehensible v define v serve as a reason or cause or justification of\"}]','ecdict_auto',0,'2026-04-06 18:41:09','2026-04-06 18:41:09'),
(694,'combinations','','n；合谱；组合；制品（combination的复数）','','','unknown','MEDIUM','[\"0:combination\",\"1:s\"]','[]','ecdict_1354178436','[{\"examples\":[],\"pos\":\"\",\"translation\":\"n. 合谱\",\"definition\":\"n a collection of things that have been combined; an assemblage of separate parts or qualities n a coordinated sequence of chess moves n a sequence of numbers or letters that opens a combination lock n a group of people (often temporary) having a common purpose n an alliance of people or corporations or countries for a special purpose (formerly to achieve some antisocial end but now for general political or economic purposes) n the act of arranging elements into specified groups without regard to order n the act of combining things to form a new whole\"}]','ecdict_auto',0,'2026-04-06 18:41:11','2026-04-06 18:41:11'),
