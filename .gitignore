# Database backups and exports (使用 Git LFS 管理)
# database/*.sql 已通过 .gitattributes 配置为使用 Git LFS
# database/backups/
# database/exports/
# *.sql.gz
# *.sql.zip
# *.sql.bz2

# Excel files with sensitive data (optional, decide based on your needs)
# *.xls
# *.xlsx

# ── 运行时备份目录（auto-update.sh / Spring Boot 备份服务产生）──
# 备份文件留在服务器，不提交到 Git
backups/*.sql
backups/*.sql.gz
backups/*.sql.bz2
backups/*.sql.zip
backups/.env.pre-update.*
# 允许 .gitkeep 保留目录结构
!backups/.gitkeep

# ── 上传文件目录（视频/图片存储）──
uploads/

# ── 持久化数据目录（bind mount，不入库）──
# 先允许 .gitkeep，再排除目录内容
!data/
!data/mysql-master/
!data/mysql-slave/
!data/redis/
!data/app-logs/
!data/app-uploads/
