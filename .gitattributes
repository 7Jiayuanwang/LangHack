# 统一行尾：所有文本文件在仓库中使用 LF，在 Windows 检出时自动转 CRLF
* text=auto eol=lf
# 源代码和配置文件明确使用 LF
*.java      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.properties text eol=lf
# SQL 文件使用 LF（已从 LFS 移除，作为普通文本跟踪）
*.sql       text eol=lf
# Windows 批处理文件使用 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
# 二进制文件不转换
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.jar       binary
*.class     binary
